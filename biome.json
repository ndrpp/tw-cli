{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!docs/endpoints.json", "!test/fixtures", "!src/web/assets", "!package-lock.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "auto"
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/game/**", "src/http/**", "src/auth/**", "src/realtime/**", "src/util/**", "scripts/**"],
      "linter": {
        "rules": {
          "correctness": { "useHookAtTopLevel": "off", "noComponentHookFactories": "off" }
        }
      }
    },
    {
      "includes": ["test/**"],
      "linter": {
        "rules": {
          "suspicious": { "noExplicitAny": "off", "noControlCharactersInRegex": "off" },
          "style": { "noNonNullAssertion": "off" }
        }
      }
    }
  ]
}
